# Copy to .env (git-ignored). Server-side only. Never prefix secrets with VITE_.
# Chain endpoints (public, verified in docs/CHAIN_NOTES.md)
QORE_CHAIN_ID=qorechain-diana
QORE_EVM_CHAIN_ID=
QORE_EVM_RPC=
QORE_EVM_WS=
QORE_COSMOS_RPC=
QORE_REST=

# Owner (fleet owner, PQ-registered). Used by scripts/ and the release endpoint.
OWNER_MNEMONIC=
OWNER_PQC_SECRET_KEY_HEX=

# Sentinel (Railway service)
SENTINEL_MNEMONIC=
SENTINEL_PQC_SECRET_KEY_HEX=

# Deployed contract
FLEET_REGISTRY_ADDRESS=

# LLM incident reports (optional; template fallback if empty)
ANTHROPIC_API_KEY=
