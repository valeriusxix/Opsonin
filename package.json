{
  "name": "opsonin",
  "private": true,
  "version": "0.0.0",
  "description": "A fleet immune system on QoreChain: a stolen key can only stop robots, only a post-quantum key can bring them back.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:web": "pnpm --filter @opsonin/web dev",
    "dev:sentinel": "pnpm --filter @opsonin/sentinel dev"
  }
}
